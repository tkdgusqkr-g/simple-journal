# Firebase Web SDK config (public — these go in client-side bundle)
# Source: https://console.firebase.google.com → Project Settings → General →
# Your apps → Web app → SDK setup and configuration
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=simple-journal-e6196
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# API target — overrides the default dev endpoint when set
PUBLIC_API_BASE_URL=
PUBLIC_ENVIRONMENT=dev
