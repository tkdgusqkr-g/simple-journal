{
  "name": "@simple-journal/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply simple-journal-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply simple-journal-db --remote",
    "db:studio": "drizzle-kit studio",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@simple-journal/shared-types": "workspace:*",
    "@simple-journal/shared-config": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "firebase-admin": "^13.0.1",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "nanoid": "^5.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
