# Normalize line endings to LF for all text files.
* text=auto eol=lf

# Explicit text files (defensive)
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.svelte    text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.swift     text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf
*.gradle    text eol=lf
*.sh        text eol=lf
*.toml      text eol=lf
*.xml       text eol=lf

# Ensure shell scripts and gradle wrappers stay LF even on Windows
gradlew     text eol=lf
*.sh        text eol=lf

# Windows-only files keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
gradlew.bat text eol=crlf

# Binary files (no line ending normalization)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.icns      binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.jar       binary
*.aar       binary
*.keystore  binary
*.jks       binary
*.p12       binary
*.p8        binary
*.cer       binary
*.pem       binary

# Generated lockfiles — keep LF and never reformat
pnpm-lock.yaml -diff
